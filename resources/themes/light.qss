/* 鼠鼠大王工具箱 - Light theme */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMainWindow, QWidget#central, QStackedWidget, QWidget#pageRoot, QDialog {
    background-color: #f5f6fa;
    color: #2c3e50;
}

/* Sidebar */
QTreeWidget#sidebar {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e0e4ea;
    outline: none;
    padding: 8px 6px;
}
QTreeWidget#sidebar::item {
    padding: 10px 12px;
    border-radius: 6px;
    color: #4a5568;
}
QTreeWidget#sidebar::item:hover {
    background-color: #eef1f6;
}
QTreeWidget#sidebar::item:selected {
    background-color: #2d6cdf;
    color: #ffffff;
}

QLabel#appTitle {
    font-size: 15px;
    font-weight: 600;
    padding: 10px 14px;
    color: #2c3e50;
}

/* Buttons */
QPushButton {
    background-color: #2d6cdf;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover { background-color: #3a7aee; }
QPushButton:pressed { background-color: #275cc0; }
QPushButton:disabled { background-color: #c3c9d4; color: #f0f2f5; }
QPushButton#ghost {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #d4d9e0;
}
QPushButton#ghost:hover { background-color: #eef1f6; }

/* Combo */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d4d9e0;
    border-radius: 6px;
    padding: 6px 12px;
    color: #2c3e50;
}
QLineEdit:focus {
    border-color: #2d6cdf;
}
QLabel#myCodeText {
    font-family: Consolas, "Microsoft YaHei", monospace;
    font-size: 12px;
    color: #2c3e50;
}
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d4d9e0;
    border-radius: 6px;
    padding: 6px 12px;
    color: #2c3e50;
}
/* 去掉下拉箭头：保留右侧点击区域，视觉更简洁 */
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d4d9e0;
    selection-background-color: #2d6cdf;
    selection-color: #ffffff;
}

/* Labels */
QLabel { color: #2c3e50; }
QLabel#hint { color: #7a8699; }
QLabel#timer {
    font-size: 18px;
    font-weight: 700;
    color: #2d6cdf;
}

/* Graphics view */
QGraphicsView {
    background-color: #e8ebf1;
    border: 1px solid #d4d9e0;
    border-radius: 8px;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #d4d9e0;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #4a5568;
}

/* Table */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f3f5f9;
    border: 1px solid #d4d9e0;
    border-radius: 8px;
    color: #2c3e50;
}
QTableWidget::item {
    padding: 4px 8px;
}
QTableWidget::item:selected {
    background-color: #2d6cdf;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #eef1f6;
    color: #4a5568;
    border: none;
    border-right: 1px solid #d4d9e0;
    border-bottom: 1px solid #d4d9e0;
    padding: 6px 10px;
    font-weight: 600;
}

/* Source cards */
QListWidget#sourceList {
    background: transparent;
    border: none;
    outline: none;
}
QFrame#sourceCard {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 10px;
}
QFrame#sourceCard:hover {
    border-color: #2d6cdf;
}
QLabel#sourceThumb {
    background-color: #eef1f6;
    border-radius: 6px;
}
QLabel#sourceAuthor {
    color: #2c3e50;
    font-weight: 600;
}
QLabel#sourceUrl {
    color: #7a8699;
}
QLabel#sourceBest {
    color: #2d6cdf;
    font-weight: 600;
}

/* Daily password cards */
QScrollArea#pwdList {
    background: transparent;
    border: none;
}
QWidget#pwdFlowHost {
    background: transparent;
}
QFrame#pwdCard {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 10px;
}
QFrame#pwdCard:hover {
    border-color: #2d6cdf;
}
QWidget#pwdPreview {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 10px;
}
QLabel#pwdPreviewTitle {
    color: #2c3e50;
    font-weight: 600;
}
QLabel#pwdPreviewImage {
    border-radius: 6px;
    background-color: #000000;
}
QLabel#pwdTitle {
    color: #2c3e50;
    font-weight: 600;
}
QLabel#pwdCode {
    font-size: 26px;
    font-weight: 700;
    color: #2d6cdf;
}
QLabel#pwdImage {
    border-radius: 6px;
    background-color: #000000;
}
QLabel#pwdLoc {
    color: #7a8699;
    background: transparent;
}
QScrollArea#pwdDescScroll {
    background: transparent;
    border: none;
}
QScrollArea#pwdDescScroll > QWidget > QWidget {
    background: transparent;
}

/* Scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c8cdd6;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #b0b6c2;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #c8cdd6;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #b0b6c2;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Splitter handle */
QSplitter::handle {
    background-color: #e0e4ea;
}
QSplitter::handle:hover {
    background-color: #2d6cdf;
}
QSplitter::handle:horizontal {
    width: 6px;
}

QStatusBar { background-color: #ffffff; border-top: 1px solid #e0e4ea; color: #7a8699; }

/* Gun code cards (主播推荐) */
QScrollArea#gunList {
    background: transparent;
    border: none;
}
QWidget#gunFlowHost {
    background: transparent;
}
QFrame#gunCard {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 10px;
}
QFrame#gunCard:hover {
    border-color: #2d6cdf;
}
QLabel#gunPreview {
    border-radius: 6px;
    background-color: #f1f4f9;
    color: #9aa5b5;
    font-size: 11px;
}
QLabel#gunTitle {
    color: #2c3e50;
    font-weight: 600;
}
QLabel#gunMeta {
    color: #7a8699;
}
QLabel#gunAuthor {
    color: #2c3e50;
    font-weight: 600;
}
QLabel#gunChannel {
    color: #2d6cdf;
    background-color: rgba(45, 108, 223, 0.12);
    border-radius: 8px;
    padding: 1px 6px;
    font-size: 11px;
}
QLabel#gunAvatar {
    background-color: #e8ecf2;
    border-radius: 17px;
    color: #7a8699;
    font-size: 13px;
}
QLabel#gunComment {
    color: #7a8699;
}
QLabel#gunTags {
    color: #2d6cdf;
}
QLabel#gunPrice {
    color: #b8860b;
    font-weight: 600;
}
QPushButton#gunCopy {
    background-color: #2d6cdf;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#gunCopy:hover {
    background-color: #2458b8;
}
QPushButton#gunCopy:pressed {
    background-color: #1c4a9e;
}

/* Gun filter bar + desc scroll */
QLabel#gunFilterLabel {
    color: #7a8699;
    font-size: 12px;
}
QComboBox#gunFilter {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 6px;
    padding: 4px 8px;
    color: #2c3e50;
    min-height: 26px;
}
QComboBox#gunFilter:hover {
    border-color: #2d6cdf;
}
QComboBox#gunFilter::drop-down {
    border: none;
    width: 0;
}
QComboBox#gunFilter QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e0e4ea;
    border-radius: 6px;
    color: #2c3e50;
    selection-background-color: #2d6cdf;
    selection-color: #ffffff;
    outline: none;
}
QScrollArea#gunDescScroll {
    background: transparent;
    border: none;
}
QScrollArea#gunDescScroll > QWidget > QWidget {
    background: transparent;
}
QLabel#gunDesc {
    color: #7a8699;
    background: transparent;
    font-size: 12px;
}

/* 改枪码翻页控件 */
QPushButton#gunPagerBtn, QPushButton#gunFilterReset {
  background: #f2f3f5;
  border: 1px solid #d9dce1;
  border-radius: 6px;
  padding: 4px 10px;
  color: #33363d;
}
QPushButton#gunPagerBtn:hover, QPushButton#gunFilterReset:hover { background: #e7eaef; }
QPushButton#gunPagerBtn:disabled { color: #b8bcc3; }
QPushButton#gunPagerNum {
  min-width: 30px;
  min-height: 26px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #33363d;
  padding: 0;
}
QPushButton#gunPagerNum:hover { background: #e7eaef; }
QPushButton#gunPagerNumActive {
  min-width: 30px;
  min-height: 26px;
  border: none;
  border-radius: 6px;
  background: #2d6cdf;
  color: #ffffff;
  padding: 0;
}
QLabel#gunPagerLabel { color: #6b7078; padding: 0 8px; }
QPushButton#myCodeDelete {
    background: transparent;
    border: 1px solid #d93025;
    border-radius: 4px;
    padding: 4px 10px;
    color: #d93025;
}
QPushButton#myCodeDelete:hover {
    background: rgba(217, 48, 37, 0.10);
}

/* 首页右上角提示条（非弹窗更新/状态提示） */
QFrame#noticeBar {
    background: #f1f5f9;
    border: 1px solid #d8dee9;
    border-radius: 6px;
}
QLabel#noticeMessage {
    color: #3d4a5c;
    font-size: 12px;
}
QPushButton#noticeAction {
    background: transparent;
    border: none;
    color: #4d8ff7;
    font-weight: bold;
    font-size: 12px;
    padding: 0 4px;
}
QPushButton#noticeAction:hover { text-decoration: underline; }
QPushButton#noticeClose {
    background: transparent;
    border: none;
    color: #7a8699;
    font-size: 14px;
    padding: 0;
}
QPushButton#noticeClose:hover { color: #111827; }
