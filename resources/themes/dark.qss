/* 鼠鼠大王工具箱 - Dark theme */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

QMainWindow, QWidget#central, QStackedWidget, QWidget#pageRoot, QDialog {
    background-color: #1c1f26;
    color: #d7dce3;
}

/* Sidebar */
QTreeWidget#sidebar {
    background-color: #232730;
    border: none;
    border-right: 1px solid #303540;
    outline: none;
    padding: 8px 6px;
}
QTreeWidget#sidebar::item {
    padding: 10px 12px;
    border-radius: 6px;
    color: #a8b0bb;
}
QTreeWidget#sidebar::item:hover {
    background-color: #2e3340;
}
QTreeWidget#sidebar::item:selected {
    background-color: #2d6cdf;
    color: #ffffff;
}

QLabel#appTitle {
    font-size: 15px;
    font-weight: 600;
    padding: 10px 14px;
    color: #d7dce3;
}

/* Buttons */
QPushButton {
    background-color: #2d6cdf;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}
QPushButton:hover { background-color: #3a7aee; }
QPushButton:pressed { background-color: #275cc0; }
QPushButton:disabled { background-color: #3a3f4a; color: #6a7280; }
QPushButton#ghost {
    background-color: #2a2f3a;
    color: #d7dce3;
    border: 1px solid #3a3f4a;
}
QPushButton#ghost:hover { background-color: #333947; }

/* Combo */
QComboBox {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    border-radius: 6px;
    padding: 6px 12px;
    color: #d7dce3;
}
/* 去掉下拉箭头：保留右侧点击区域，视觉更简洁 */
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    selection-background-color: #2d6cdf;
    selection-color: #ffffff;
}

/* Labels */
QLabel { color: #d7dce3; }
QLabel#hint { color: #7d8794; }
QLabel#timer {
    font-size: 18px;
    font-weight: 700;
    color: #5b9cff;
}

/* Graphics view */
QGraphicsView {
    background-color: #15171c;
    border: 1px solid #303540;
    border-radius: 8px;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #303540;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #232730;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #a8b0bb;
}

/* Table */
QTableWidget {
    background-color: #232730;
    alternate-background-color: #1f232b;
    border: 1px solid #303540;
    border-radius: 8px;
    color: #d7dce3;
}
QTableWidget::item {
    padding: 4px 8px;
}
QTableWidget::item:selected {
    background-color: #2d6cdf;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #2a2f3a;
    color: #a8b0bb;
    border: none;
    border-right: 1px solid #303540;
    border-bottom: 1px solid #303540;
    padding: 6px 10px;
    font-weight: 600;
}

/* Source cards */
QListWidget#sourceList {
    background: transparent;
    border: none;
    outline: none;
}
QFrame#sourceCard {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    border-radius: 10px;
}
QFrame#sourceCard:hover {
    border-color: #5b9cff;
}
QLabel#sourceThumb {
    background-color: #1c1f26;
    border-radius: 6px;
}
QLabel#sourceAuthor {
    color: #d7dce3;
    font-weight: 600;
}
QLabel#sourceUrl {
    color: #7d8794;
}
QLabel#sourceBest {
    color: #5b9cff;
    font-weight: 600;
}

/* Daily password cards */
QScrollArea#pwdList {
    background: transparent;
    border: none;
}
QWidget#pwdFlowHost {
    background: transparent;
}
QFrame#pwdCard {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    border-radius: 10px;
}
QFrame#pwdCard:hover {
    border-color: #5b9cff;
}
QWidget#pwdPreview {
    background-color: #1f232b;
    border: 1px solid #3a3f4a;
    border-radius: 10px;
}
QLabel#pwdPreviewTitle {
    color: #d7dce3;
    font-weight: 600;
}
QLabel#pwdPreviewImage {
    border-radius: 6px;
    background-color: #000000;
}
QLabel#pwdTitle {
    color: #d7dce3;
    font-weight: 600;
}
QLabel#pwdCode {
    font-size: 26px;
    font-weight: 700;
    color: #5b9cff;
}
QLabel#pwdImage {
    border-radius: 6px;
    background-color: #000000;
}
QLabel#pwdLoc {
    color: #7d8794;
    background: transparent;
}
QScrollArea#pwdDescScroll {
    background: transparent;
    border: none;
}
QScrollArea#pwdDescScroll > QWidget > QWidget {
    background: transparent;
}

/* Scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a3f4a;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4a5060;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3a3f4a;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4a5060;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Splitter handle */
QSplitter::handle {
    background-color: #303540;
}
QSplitter::handle:hover {
    background-color: #2d6cdf;
}
QSplitter::handle:horizontal {
    width: 6px;
}

QStatusBar { background-color: #232730; border-top: 1px solid #303540; color: #7d8794; }

/* Gun code cards (主播推荐) */
QScrollArea#gunList {
    background: transparent;
    border: none;
}
QWidget#gunFlowHost {
    background: transparent;
}
QFrame#gunCard {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    border-radius: 10px;
}
QFrame#gunCard:hover {
    border-color: #5b9cff;
}
QLabel#gunPreview {
    border-radius: 6px;
    background-color: #1f232b;
    color: #7d8794;
    font-size: 11px;
}
QLabel#gunTitle {
    color: #d7dce3;
    font-weight: 600;
}
QLabel#gunMeta {
    color: #7d8794;
}
QLabel#gunAuthor {
    color: #d7dce3;
    font-weight: 600;
}
QLabel#gunChannel {
    color: #5b9cff;
    background-color: rgba(91, 156, 255, 0.16);
    border-radius: 8px;
    padding: 1px 6px;
    font-size: 11px;
}
QLabel#gunAvatar {
    background-color: #3a3f4a;
    border-radius: 17px;
    color: #7d8794;
    font-size: 13px;
}
QLabel#gunComment {
    color: #7d8794;
}
QLabel#gunTags {
    color: #5b9cff;
}
QLabel#gunPrice {
    color: #f3da94;
    font-weight: 600;
}
QPushButton#gunCopy {
    background-color: #2d6cdf;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#gunCopy:hover {
    background-color: #3b82f6;
}
QPushButton#gunCopy:pressed {
    background-color: #2458b8;
}

/* Gun filter bar + desc scroll */
QLabel#gunFilterLabel {
    color: #7d8794;
    font-size: 12px;
}
QComboBox#gunFilter {
    background-color: #232730;
    border: 1px solid #3a3f4a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #d7dce3;
    min-height: 26px;
}
QComboBox#gunFilter:hover {
    border-color: #5b9cff;
}
QComboBox#gunFilter::drop-down {
    border: none;
    width: 0;
}
QComboBox#gunFilter QAbstractItemView {
    background-color: #2a2f3a;
    border: 1px solid #3a3f4a;
    border-radius: 6px;
    color: #d7dce3;
    selection-background-color: #2d6cdf;
    selection-color: #ffffff;
    outline: none;
}
QScrollArea#gunDescScroll {
    background: transparent;
    border: none;
}
QScrollArea#gunDescScroll > QWidget > QWidget {
    background: transparent;
}
QLabel#gunDesc {
    color: #7d8794;
    background: transparent;
    font-size: 12px;
}

/* 改枪码翻页控件 */
QPushButton#gunPagerBtn, QPushButton#gunFilterReset {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 6px;
  padding: 4px 10px;
  color: #e8e8ea;
}
QPushButton#gunPagerBtn:hover, QPushButton#gunFilterReset:hover { background: rgba(255, 255, 255, 0.16); }
QPushButton#gunPagerBtn:disabled { color: rgba(232, 232, 234, 0.35); }
QPushButton#gunPagerNum {
  min-width: 30px;
  min-height: 26px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #e8e8ea;
  padding: 0;
}
QPushButton#gunPagerNum:hover { background: rgba(255, 255, 255, 0.16); }
QPushButton#gunPagerNumActive {
  min-width: 30px;
  min-height: 26px;
  border: none;
  border-radius: 6px;
  background: #2d6cdf;
  color: #ffffff;
  padding: 0;
}
QLabel#gunPagerLabel { color: #b8b8bd; padding: 0 8px; }
